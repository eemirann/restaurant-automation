# ============================================================
# Restoran Backend - Ortam Değişkenleri
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldurun.
# .env dosyasını ASLA versiyon kontrolüne eklemeyin.
# ============================================================

# --- Veritabanı (Microsoft SQL Server) ---
# DB_SERVER iki biçimi de kabul eder (bkz. config/db.js):
#   localhost              -> DB_PORT üzerinden bağlanır (Docker / varsayılan instance)
#   localhost\SQLEXPRESS   -> ADLANDIRILMIŞ instance; portu SQL Browser çözer,
#                             DB_PORT bu durumda YOK SAYILIR.
# Windows kurulumunda (installer/) SQL Server Express kullanılır:
DB_SERVER=localhost\SQLEXPRESS
DB_DATABASE=RestoranDB
DB_USER=sa
DB_PASSWORD=degistir_beni
DB_PORT=1433

# --- Yedekleme ---
# BACKUP_DISK_DIR: SQL Server sürecinin gördüğü yol (T-SQL BACKUP ... TO DISK)
# BACKUP_FS_DIR  : bu Node sürecinin gördüğü yol (dosya listeleme/silme)
# Aynı makinede çalışıyorsa (SQL Express) ikisi de AYNI klasördür.
# Docker'da farklıdır (iki konteynerde iki mount noktası) — varsayılanlar odur.
#BACKUP_DISK_DIR=C:\RestoranOtomasyonu\db-backups
#BACKUP_FS_DIR=C:\RestoranOtomasyonu\db-backups

# --- Kimlik doğrulama ---
# JWT_SECRET zorunludur; boşsa sunucu başlamaz. Uzun, rastgele bir değer kullanın.
JWT_SECRET=uzun-rastgele-bir-gizli-anahtar-buraya

# --- Sunucu ---
# !!! 4091 SABİT !!! restoran-panel Tauri exe'si bu adresi BUILD ANINDA
# içine gömüyor; değiştirilirse masaüstü uygulaması backend'i bulamaz.
PORT=4091

# --- Müşteri QR menüsü ---
# Backend, musteri-menu/dist'i statik olarak servis eder (bkz. server.js).
# Varsayılan: <proje kökü>/musteri-menu/dist. Farklı bir yerdeyse:
#MENU_DIST_DIR=C:\RestoranOtomasyonu\musteri-menu\dist
# production => morgan 'combined' log formatı kullanır
NODE_ENV=development

# --- CORS ---
# Panel(ler)in origin'lerini virgülle ayırarak yazın.
# Boş bırakılırsa tüm origin'lere izin verilir (SADECE geliştirme için).
CORS_ORIGIN=http://localhost:5173

# --- Docker Compose (yalnızca compose kullanılıyorsa) ---
# Panel imajı build edilirken gömülecek backend API adresi.
VITE_API_URL=http://localhost:4091/api
