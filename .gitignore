# Offline USB kurulum paketi (scripts/paketle.ps1 ile HER SEFERİNDE yeniden
# üretilir) — SQL Server Express kurulumu, Node.js MSI'ı ve derlenmiş Inno
# Setup çıktısı (installer/RestoranKurulum.iss OutputDir'i bu klasörü
# hedefler) repoya ASLA commitlenmez.
/KurulumPaketi/
*.tar
SQLEXPR_x64_ENU.exe
SQL20*-SSEI-Expr.exe
node-v*-x64.msi
# NSSM (https://nssm.cc/download > win64\nssm.exe) — kurulum programına
# gömülen üçüncü parti ikili; repoda tutulmaz, elle indirilir.
installer/nssm.exe
# Taşınabilir Node.js — kurulum programına gömülür (backend'i sistemdeki
# Node.js'ten bağımsız çalıştırmak için). ~88 MB, repoda tutulmaz;
# scripts/masaustu-hazirla.mjs'in ürettiği src-tauri/binaries/node-*.exe
# dosyasından kopyalanır.
installer/node.exe

# Offline GÜNCELLEME paketi (scripts/paketle-guncelle.ps1 ile her seferinde
# yeniden üretilir): içindeki migrations/ ve guncelle.ps1 dosyaları repodaki
# migrations/ ve installer/guncelle.ps1'in KOPYASIDIR — ikisini birden
# commitlemek kaynakları ikizleyip senkrondan çıkarır.
/Guncelleme/

# ============================================================
# RESTO POS masaüstü (Tauri) derleme çıktıları
# ============================================================
# Rust derleme önbelleği (GB'larca)
/src-tauri/target/
# Derleme çıktısını OneDrive dışına taşıyan MAKİNEYE ÖZEL ayar
/src-tauri/.cargo/
# scripts/masaustu-hazirla.mjs tarafından HER derlemede yeniden üretilir
/src-tauri/backend-dist/
/src-tauri/binaries/
/src-tauri/gen/
# İkon üretim hattının ara çıktıları (kaynak: branding/resto-icon.svg)
/branding/dist/

# GÜNCELLEME İMZA ANAHTARI — ASLA commitlenmez.
# Bu özel anahtar kaybolursa mevcut kurulumlara güncelleme yayınlanamaz;
# ayrı ve güvenli bir yerde yedeklenmelidir (bkz. MASAUSTU.md).
/.secrets/
